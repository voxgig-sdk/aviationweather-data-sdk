# Entity: taf

main: kit: entity: taf: {

  alias: field: {}

  fields: [
    {
      name: "bulletinTime"
      req: false
      short: "Bulletin time in ISO8601 format"
      type: "`$STRING`"
    }
    {
      name: "elev"
      req: false
      short: "Elevation in meters"
      type: "`$NUMBER`"
    }
    {
      name: "fcsts"
      req: false
      short: "Forecast periods"
      type: "`$ARRAY`"
    }
    {
      name: "icaoId"
      req: false
      short: "ICAO station identifier"
      type: "`$STRING`"
    }
    {
      name: "issueTime"
      req: false
      short: "TAF issue time in ISO8601 format"
      type: "`$STRING`"
    }
    {
      name: "lat"
      req: false
      short: "Latitude"
      type: "`$NUMBER`"
    }
    {
      name: "lon"
      req: false
      short: "Longitude"
      type: "`$NUMBER`"
    }
    {
      name: "name"
      req: false
      short: "Station name"
      type: "`$STRING`"
    }
    {
      name: "rawTAF"
      req: false
      short: "Raw TAF forecast text"
      type: "`$STRING`"
    }
    {
      name: "validTimeFrom"
      req: false
      short: "Valid time from in ISO8601 format"
      type: "`$STRING`"
    }
    {
      name: "validTimeTo"
      req: false
      short: "Valid time to in ISO8601 format"
      type: "`$STRING`"
    }
  ]

  name: "taf"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "bbox"
                orig: "bbox"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "date"
                orig: "date"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "raw"
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "ids"
                orig: "ids"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/data/taf"
          parts: [
            "api"
            "data"
            "taf"
          ]
          select: {
            exist: [
              "bbox"
              "date"
              "format"
              "ids"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
