                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/data/pirep"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "data"
            }
            {
              lit: "pirep"
            }
          ]
          select: {
            exist: [
              "age"
              "bbox"
              "date"
              "format"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



