      req: false
      short: "Wind speed in knots"
      type: "`$INTEGER`"
    }
    {
      name: "wxString"
      req: false
      short: "Weather phenomena string"
      type: "`$STRING`"
    }
  ]

  name: "pirep"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "age"
                orig: "age"
