# Entity: pirep

main: kit: entity: pirep: {

  alias: field: {}

  fields: [
    {
      name: "aircraftType"
      req: false
      short: "Aircraft type"
      type: "`$STRING`"
    }
    {
      name: "altitudeFt"
      req: false
      short: "Altitude in feet MSL"
      type: "`$INTEGER`"
    }
    {
      name: "clouds"
      req: false
      short: "Cloud reports"
      type: "`$ARRAY`"
    }
    {
      name: "icing"
      req: false
      short: "Icing report"
      type: "`$STRING`"
    }
    {
      name: "lat"
      req: false
      short: "Latitude"
      type: "`$NUMBER`"
    }
    {
      name: "lon"
      req: false
      short: "Longitude"
      type: "`$NUMBER`"
    }
    {
      format: "date-time"
      name: "obsTime"
      req: false
      short: "Observation time in ISO8601 format"
      type: "`$STRING`"
    }
    {
      name: "rawOb"
      req: false
      short: "Raw PIREP text"
      type: "`$STRING`"
    }
    {
      name: "reportType"
      req: false
