  }

  name: "taf"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/data/taf"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "bbox"
