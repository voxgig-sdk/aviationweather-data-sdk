              }
            ]
          }
          m: "GET"
          o: "/api/data/taf"
          q: {
            exist: [
              "bbox"
              "date"
              "format"
              "ids"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "data"
            }
            {
              lit: "taf"
            }
          ]
          t: {
            req: "`reqdata`"
